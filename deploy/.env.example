# Copie para ~/nexus-ai/.env na VM. Nenhum valor aqui é segredo:
# a chave da Groq fica no OCI Vault e só o OCID dela aparece abaixo.

# Imagem no OCIR (o pipeline sobrescreve com a tag do commit a cada deploy).
NEXUS_IMAGE=gru.ocir.io/<namespace>/nexus-ai:latest

# OCID do segredo com a chave da Groq no OCI Vault.
NEXUS_GROQ_SECRET_OCID=ocid1.vaultsecret.oc1.sa-saopaulo-1.xxxxx

# Bucket do Object Storage com os documentos originais.
NEXUS_DOCUMENTS_BUCKET=nexus-documentos
NEXUS_DOCUMENTS_PREFIX=
NEXUS_SYNC_INTERVALO_MIN=15

# Domínio público. Sem domínio próprio, use <IP-com-hifens>.sslip.io,
# por exemplo 129-151-10-20.sslip.io para o IP 129.151.10.20.
NEXUS_DOMAIN=129-151-10-20.sslip.io

# Login das rotas de manutenção. Gere o hash com:
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'sua-senha'
# Use aspas simples: o hash contém "$".
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_HASH='$2a$14$troque-pelo-hash-gerado'
